[configuration]

entry_symbol = "lastday_nav_library_init"
compatibility_minimum = "4.7"

[libraries]

macos.debug = "res://native/bin/liblastday_nav.dylib"
macos.release = "res://native/bin/liblastday_nav.dylib"
windows.debug.x86_64 = "res://native/bin/lastday_nav.dll"
windows.release.x86_64 = "res://native/bin/lastday_nav.dll"
linux.debug.x86_64 = "res://native/bin/liblastday_nav.so"
linux.release.x86_64 = "res://native/bin/liblastday_nav.so"
