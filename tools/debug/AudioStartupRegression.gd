extends SceneTree
const Startup = preload("res://scripts/AudioStartup.gd")
var failures := 0
func check(ok: bool, label: String) -> void:
	if not ok: failures += 1
	print("PASS: " if ok else "FAIL: ", label)
func _initialize() -> void:
	check(Startup.needs_output_recovery("macOS", "Dummy", true, false, false), "failed macOS input triggers output recovery")
	check(Startup.needs_output_recovery("Linux", "Dummy", true, false, false), "failed Linux input triggers output recovery")
	check(not Startup.needs_output_recovery("macOS", "Dummy", false, false, false), "output-only retry cannot loop")
	check(not Startup.needs_output_recovery("macOS", "CoreAudio", true, false, false), "working microphone/output remain enabled")
	check(not Startup.needs_output_recovery("macOS", "Dummy", true, true, false), "headless server never restarts")
	check(not Startup.needs_output_recovery("macOS", "Dummy", true, false, true), "explicit Dummy choice is respected")
	check(not Startup.needs_output_recovery("Windows", "Dummy", true, false, false), "input recovery is limited to the desktop platforms with this failure")
	check(Startup.preferred_local_output_device(PackedStringArray(["chrome_remote_desktop_session", "alsa_output.pci-sofhdadsp-speaker"])) == "alsa_output.pci-sofhdadsp-speaker", "Linux prefers laptop speakers over the CRD audio sink")
	check(Startup.preferred_local_output_device(PackedStringArray(["chrome_remote_desktop_session"])).is_empty(), "Linux leaves output unchanged when only the remote sink exists")
	check(Startup.needs_local_audio_route_restart("Linux", "/run/user/1000/crd_audio#session", "", "chrome_remote_desktop_session"), "Linux detects the private CRD audio route")
	check(not Startup.needs_local_audio_route_restart("Linux", "/run/user/1000", "unix:/run/user/1000/pulse/native", ""), "normal Linux PipeWire route is left alone")
	check(not Startup.needs_local_audio_route_restart("macOS", "crd_audio", "", ""), "CRD route recovery is Linux-only")
	var path := OS.get_temp_dir().path_join("lastday_audio_settings_%d.cfg" % OS.get_process_id())
	var cfg := ConfigFile.new()
	cfg.set_value("other", "preserved", 42)
	cfg.save(path)
	check(Startup.save_input_preference(false, path) == OK, "output-only override is writable")
	cfg.load(path)
	check(cfg.get_value("audio", "driver/enable_input") == false and cfg.get_value("other", "preserved") == 42, "override changes input only")
	check(Startup.save_input_preference(true, path) == OK, "user can enable microphone for next boot")
	cfg.load(path)
	check(cfg.get_value("audio", "driver/enable_input") == true, "microphone opt-in persists")
	DirAccess.remove_absolute(path)
	print("failures=", failures)
	quit(1 if failures else 0)
